<?xml version="1.0" encoding="utf-8" ?>
<!--
  AndroidManifest.xml for the SnackPilot gpui-kit Android host (task 2.1).

  Mirrors the gpui-mobile example manifest (rev 0b882efd) minus the packages
  the spike does not use (pickers, deep links, permissions, splash):
    - NativeActivity-based host so the lifecycle is driven from Rust.
    - android.app.lib_name selects the Rust cdylib (placeholder from
      build.gradle.kts).
    - configChanges keeps the Activity (and the single gpui-kit Root) alive
      across rotation/keyboard/uiMode changes instead of recreating it (D11).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- GPU hardware acceleration is required for wgpu rendering. -->
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />

    <!-- Vulkan is preferred but the app falls back to OpenGL ES. -->
    <uses-feature
        android:name="android.hardware.vulkan.level"
        android:required="false"
        android:version="0"
    />
    <uses-feature
        android:name="android.hardware.vulkan.version"
        android:required="false"
        android:version="0x00401000"
    />

    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false"
    />

    <application
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:largeHeap="true"
        android:label="SnackPilot"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
    >

        <activity
            android:name="dev.radaiko.gourmetclient.SnackPilotActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|uiMode|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="unspecified"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
            android:windowSoftInputMode="adjustResize"
        >

            <!-- The Rust cdylib name without "lib" prefix / ".so" suffix. -->
            <meta-data
                android:name="android.app.lib_name"
                android:value="${nativeLibraryName}"
            />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
